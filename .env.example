# ── Bulk Product Image Generator (scripts/generate-product-images.js) ──
# Copy this file to .env.local and fill in the values.

# ═══ FREE mode (default) — sirf ye 2 chahiye ═══
# Cloudinary Dashboard → Settings → API Keys (dono FREE hain)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ═══ Optional (sirf --source gemini/auto ke liye) ═══
# Google AI Studio se (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_api_key

# ═══ Optional (recommended for Supabase inserts) ═══
# Supabase Dashboard → Settings → API → service_role
# Nahin di to anon key se try hoga (RLS allow kare to)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults already set in the script)
# SUPABASE_URL=https://pffaflasgwhydkmxwkky.supabase.co
# SUPABASE_ANON_KEY=sb_publishable__tFDYhkM3blZ0pIVT0YxLA_YvkKq79L
# CLOUDINARY_CLOUD_NAME=delf8iyzt
# CLOUDINARY_FOLDER=myshop/products
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
